---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import WhatsApp from '../components/WhatsApp.astro';
import ProductCard from '../components/ProductCard.astro';
import {products,money} from '../data/products';
import {whatsapp} from '../data/contact';
const deals=products.filter(p=>p.featuredOffer);
const categories=[{label:'Office chairs',category:'Seating',image:'10.jpg',copy:'A better seat for your daily hustle.'},{label:'Desks & storage',category:'Desks',image:'5.jpg',copy:'Big ideas need a little space.'},{label:'Complete workspaces',category:'Workspace sets',image:'4.jpg',copy:'Bring your whole setup together.'}];
---
<Layout title="Nicoo Furniture — Your space. Your next chapter.">
<section class="cinema-hero" aria-label="Welcome to Nicoo Furniture">
 <img class="cinema-image" src="/images/nairobi-workspace.webp" alt="Illustrative Kenyan home office with two adults and a sunlit workspace" width="1536" height="1024" fetchpriority="high"/>
 <div class="cinema-shade"></div><div class="hero-ambient" aria-hidden="true"></div><div class="hero-coordinate" aria-hidden="true"><span>EST. IN NAIROBI</span><i>✳</i><span>MADE FOR YOUR NEXT CHAPTER</span></div>
 <div class="cinema-content"><p class="eyebrow" data-hero-reveal>MADE FOR YOUR EVERYDAY. RIGHT HERE IN NAIROBI.</p><h1 data-hero-reveal>Modern Furniture<br/>for Your Home<br/><em class="hero-underline">and Office.</em></h1><p class="cinema-description" data-hero-reveal>From the first desk to the corner office.<br/>Find furniture that works as hard as you do.</p><div class="cinema-actions" data-hero-reveal><a class="button orange-button" href="/collection">Shop furniture <Icon/></a><a class="hero-secondary" href="#offers">Explore offers ↗</a></div></div>
 <a class="hero-product-note hero-product-note--deal" href="/collection"><span class="hero-note-top">🔥 DEALS FROM</span><strong>KSh 1K</strong><span class="hero-note-cta">Grab yours now <Icon size={17}/></span></a>
 <div class="hero-bottom-line"><span>01 / THE EVERYDAY EDIT</span><a href="#shop-categories">SCROLL TO DISCOVER <span class="scroll-arrow">↓</span></a><button id="motion-toggle" type="button" aria-pressed="false">Pause motion Ⅱ</button></div>
</section>
<div class="shop-ribbon"><span>Karibu Nicoo</span><span>✳</span><span>Good furniture. Real possibilities.</span><span>✳</span><span>Donholm, Nairobi</span><span>✳</span><span>Let’s make room for better.</span></div>
<section class="home-categories section" id="shop-categories"><div class="section-heading" data-reveal><div><p class="eyebrow">FIND YOUR KIND OF COMFORT</p><h2>What’s your next move<span class="orange">?</span></h2></div><a class="text-link" href="/collection">Shop all furniture <Icon size={20}/></a></div><div class="home-category-grid">{categories.map((c,i)=><a class="home-category" href={`/collection?category=${encodeURIComponent(c.category)}#all-products`} data-reveal><img src={`/images/${c.image}`} alt={c.label} loading="lazy" width="600" height="600"/><div><span>0{i+1} / {products.filter(p=>p.category===c.category).length} PIECES</span><h3>{c.label}</h3><p>{c.copy}</p><strong>From {money(Math.min(...products.filter(p=>p.category===c.category).map(p=>p.price)))} <Icon/></strong></div></a>)}</div></section>
<section class="offers-section" id="offers"><div class="offers-intro" data-reveal><p class="eyebrow">A LITTLE LESS SPEND. A LOT MORE SPACE.</p><h2>Fresh space.<br/><em>Fresh deals.</em></h2><span class="big-discount"><span class="discount-kicker">UP TO</span><span class="discount-value">{Math.max(...deals.map(p=>p.discountPercent))}<sup>%</sup></span><span class="discount-off">OFF</span></span><p>Three favourites. A little extra reason to make them yours.</p><span class="demo-offer-note">The price you see is the price you pay for your furniture. Delivery is arranged separately.</span><a href="/collection" class="button light">Explore the collection <Icon/></a></div><div class="offer-products">{deals.map(p=><ProductCard product={p}/>)}</div></section>
<section class="section home-picks"><div class="section-heading" data-reveal><div><p class="eyebrow">PIECES WORTH MAKING ROOM FOR</p><h2>Your everyday, upgraded<span class="orange">.</span></h2></div><div class="home-product-tabs" role="group" aria-label="Browse featured products"><button data-pick="all" aria-pressed="true" class="selected">All favourites</button><button data-pick="Seating" aria-pressed="false">Chairs</button><button data-pick="Desks" aria-pressed="false">Desks</button></div></div><div class="product-grid" id="home-products">{products.filter(p=>[1,2,3,5,6,7,9,10].includes(p.id)).map(p=><ProductCard product={p}/>)}</div><a class="button outline-button" href="/collection">View all {products.filter(p=>!p.testOnly).length} pieces <Icon/></a></section>
<section class="home-workspace" data-reveal><div class="workspace-photo"><img src="/images/4.jpg" alt="The Workday Set with desk, chair and drawer unit" loading="lazy" width="1080" height="1080"/><span>THE WORKDAY SET / 03 PIECES, ONE FRESH START</span></div><div class="workspace-pitch"><p class="eyebrow">OFISI YAKO. YOUR WAY.</p><h2>New desk.<br/>New energy.<br/><em>Same big dreams.</em></h2><p>Set yourself up with a desk, office chair and mobile storage. Your next chapter starts with a good place to work.</p><div class="workspace-price"><span>THE COMPLETE SET</span><strong>{money(products[3].price)}</strong></div><button data-add="4" class="button light">Add the set to cart <Icon name="bag"/></button><button data-product="4" class="plain-detail">See what’s included ↗</button></div></section>
<section class="budget-section section"><div class="section-heading" data-reveal><div><p class="eyebrow">YOUR BUDGET. YOUR POSSIBILITIES.</p><h2>Start where you are<span class="orange">.</span></h2></div><p>A small upgrade can make a big difference.</p></div><div class="budget-links"><a href="/collection?budget=15000#all-products"><span>THE FIRST UPGRADE</span><h3>Up to KSh 15,000</h3><p>Small spaces. Smart starts.</p><Icon/></a><a href="/collection?budget=25000#all-products"><span>A LITTLE MORE ROOM</span><h3>Up to KSh 25,000</h3><p>Find your workday favourite.</p><Icon/></a><a href="/collection?category=Workspace%20sets#all-products"><span>THE FULL PICTURE</span><h3>A complete workspace</h3><p>Put it all together.</p><Icon/></a></div></section>
<section class="people-story"><div class="people-image"><img src="/images/nairobi-people.webp" alt="AI-generated lifestyle scene of Kenyan adults exploring a furniture showroom" loading="lazy" width="1536" height="1024"/><span>LIFESTYLE INSPIRATION · AI-GENERATED</span></div><div class="people-copy" data-reveal><p class="eyebrow">FROM DONHOLM, WITH POSSIBILITY</p><h2>Furniture is personal.<br/><em>So are we.</em></h2><p>It’s where you send that first proposal. Build the business. Make the next big plan. Your space deserves more than “it will do”.</p><p>At Nicoo Furniture in Donholm, find office chairs, desks and workspaces for your next move. Karibu—let’s talk about what works for you.</p><a class="text-link" href="/about">Get to know Nicoo <Icon/></a></div></section>
<section class="section home-service"><div class="section-heading" data-reveal><div><p class="eyebrow">FROM “I LIKE IT” TO “IT’S PERFECT”</p><h2>A little help goes a long way<span class="orange">.</span></h2></div></div><div class="service-grid"><article><Icon name="pin" size={30}/><h3>Come see it in Donholm</h3><p>Check the finish. Take a seat. Picture it in your space.</p><a href="/visit">Plan your visit ↗</a></article><article><WhatsApp size={30}/><h3>Tuongee on WhatsApp</h3><p>Ask about a product, size or price before you make the trip.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer">Chat with the shop ↗</a></article><article><Icon name="truck" size={30}/><h3>Let’s talk delivery</h3><p>Share your estate and location to confirm cost and availability.</p><a href="/visit#enquiry">Ask about delivery ↗</a></article><article><Icon name="bag" size={30}/><h3>Your next workspace</h3><p>From one chair to a whole setup, start with what you need.</p><a href="/collection">Find your furniture ↗</a></article></div></section>
<section class="closing-banner"><div><p class="eyebrow">GOOD SPACES START WITH A CONVERSATION</p><h2>Uko ready for<br/><em>something better?</em></h2></div><a class="button light" href={whatsapp} target="_blank" rel="noopener noreferrer">Let’s talk on WhatsApp <WhatsApp size={21}/></a></section>
<script>import '../scripts/showroom';</script>
</Layout>
