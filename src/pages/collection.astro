---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import {shopProducts as products,categories,money} from '../data/products';
import {whatsapp} from '../data/contact';
import '../styles/collection-redesign.css';
const standing=products.find(p=>p.image.includes('electric_height_adjustable_standing_desk_white'))!;
const chair=products.find(p=>p.id===101)!;
const meeting=products.find(p=>p.category==='Conference tables')!;
const categoryLabels:Record<string,string>={'Seating':'Chairs & seating','Desks':'Everyday desks','Standing desks':'Standing desks','Workspace sets':'Workstations','Conference tables':'Meeting tables','Reception desks':'Reception','Accessories':'Finishing touches'};
const featured=[standing,chair,...products.filter(p=>![standing.id,chair.id].includes(p.id))];
---
<Layout title="The Furniture Edit — Nicoo Funiture Hub">
<div class="shop-edit">
  <section class="edit-hero">
    <div class="edit-hero-copy"><div class="edit-kicker"><span class="edit-dot"></span> THE FURNITURE EDIT <span>01 / NICOO</span></div><h1>Good work.<br/>Great spaces.<br/><em>Start here.</em></h1><p>For the corner that’s finally yours.<br/>For the team that’s getting bigger.<br/>Find furniture that fits your everyday.</p><a class="edit-primary" href="#all-products">Find your next piece <Icon name="arrow" size={21}/></a><div class="edit-hero-foot"><span>DONHOLM, NAIROBI</span><span>{products.length} PIECES. YOUR POSSIBILITIES.</span></div></div>
    <div class="edit-hero-visual"><span class="edit-vertical">A LITTLE ROOM FOR BETTER</span><img src={`/images/${standing.image}`} alt="White electric standing desk in a bright home workspace" width="1000" height="1000" fetchpriority="high"/><div class="edit-roundel" aria-hidden="true">SIT.<br/>STAND.<br/><i>MAKE ROOM.</i></div><button class="edit-image-caption" data-product={standing.id}><span><small>THE CHANGE-OF-PACE DESK</small><strong>Electric. Effortless.</strong></span><span>{money(standing.price)} <b>↗</b></span></button></div>
  </section>
  <nav class="edit-category-index" aria-label="Browse furniture categories"><span class="edit-index-label">FIND YOUR<br/><strong>kind of space.</strong></span><div>{categories.map((category,i)=><a href={`?category=${encodeURIComponent(category)}#all-products`} data-category-jump={category}><sup>0{i+1}</sup><span>{categoryLabels[category]}</span><small>{products.filter(p=>p.category===category).length}</small></a>)}</div></nav>
  <section class="edit-stories" aria-label="Furniture highlights">
    <article class="edit-chair-story"><div class="edit-story-top"><span>THE EVERYDAY UPGRADE</span><span>↘</span></div><div class="edit-chair-body"><div><h2>Take a seat.<br/><em>Stay a while.</em></h2><p>A proper chair makes<br/>all the difference.</p><button data-product={chair.id} class="edit-underlined">Meet your next chair ↗</button></div><button class="edit-chair-image" data-product={chair.id} aria-label={`View ${chair.name}`}><img src={`/images/${chair.image}`} alt={chair.name} width="650" height="800" loading="lazy"/><span>{money(chair.price)}</span></button></div><a class="edit-story-bottom" href="?category=Seating#all-products" data-category-jump="Seating">Explore all seating <span>→</span></a></article>
    <article class="edit-meeting-story"><button class="edit-meeting-image" data-product={meeting.id} aria-label={`View ${meeting.name}`}><img src={`/images/${meeting.image}`} alt={meeting.name} width="900" height="600" loading="lazy"/><span>ROOM FOR THE BIG IDEAS</span></button><div><p>BETTER, TOGETHER.</p><h2>A place at<br/><em>the table.</em></h2><button data-product={meeting.id} class="edit-underlined">The 2.4m boardroom table · {money(meeting.price)} ↗</button></div></article>
  </section>
  <section class="edit-catalog" id="all-products">
    <div class="edit-catalog-heading"><div><p class="eyebrow">LESS SCROLLING. MORE FINDING.</p><h2>Make it <em>your space.</em></h2></div><label class="edit-search"><Icon name="search" size={18}/><input id="catalog-search" type="search" aria-label="Search furniture" placeholder="What are you looking for?" autocomplete="off"/></label></div>
    <div class="edit-shop-layout">
      <aside class="edit-sidebar"><p class="edit-sidebar-label">THE COLLECTION</p><div class="edit-filters" role="group" aria-label="Filter by furniture category">{['All pieces',...categories].map((c,i)=><button data-filter={c} class:list={{selected:i===0}} aria-pressed={i===0}><span>{i===0?c:categoryLabels[c]}</span><small>{i===0?products.length:products.filter(p=>p.category===c).length}</small></button>)}</div><label class="edit-budget">Your budget<select id="budget"><option value="all">Any budget</option><option value="15000">Up to KSh 15,000</option><option value="25000">Up to KSh 25,000</option><option value="35000">Up to KSh 35,000</option><option value="100000">Up to KSh 100,000</option></select></label><div class="edit-sidebar-help"><span>↗</span><h3>Not quite sure?</h3><p>Tell us about your space.<br/>We’ll help you find the fit.</p><a href={`${whatsapp}?text=${encodeURIComponent('Hi Nicoo, I’d like help choosing furniture for my space.')}`} target="_blank" rel="noopener noreferrer">Talk to Nicoo →</a></div></aside>
      <div class="edit-results"><div class="edit-result-bar"><span id="result-count" role="status">{products.length} pieces for your space</span><label>Sort <select id="sort"><option value="featured">Our edit</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select></label></div><div class="product-grid" id="catalog-grid">{featured.map(p=><ProductCard product={p}/>)}</div><div id="catalog-empty" class="catalog-empty" hidden><h3>A little too specific?</h3><p>Try a wider budget or another search.</p><button id="reset-filters" class="edit-primary">Reset the collection ↗</button></div><p class="edit-pricing-note">Prices in KSh · Delivery arranged separately · “Ask for price” pieces are quoted by the shop.</p></div>
    </div>
  </section>
  <section class="edit-reception"><div><p class="eyebrow">FIRST IMPRESSIONS, SORTED.</p><h2>Say hello.<br/><em>Beautifully.</em></h2><p>Reception desks with a little more personality.<br/>Find the right welcome for your business.</p><a class="edit-primary" href="?category=Reception%20desks#all-products" data-category-jump="Reception desks">Explore reception desks ↗</a></div><a class="edit-reception-image" href="?category=Reception%20desks#all-products" data-category-jump="Reception desks"><img src="/images/catalog/reception_counter_wood_white_slats_front_view.webp" alt="Wood and white reception counter with horizontal detailing" width="700" height="800" loading="lazy"/><span>WOOD. WHITE. A WARM WELCOME. ↗</span></a><span class="edit-reception-number" aria-hidden="true">HELLO.</span></section>
  <section class="edit-service-strip"><div><span>01</span><h3>See it in person.</h3><p>Visit us in Donholm, Nairobi.</p><a href="/visit">Plan a visit ↗</a></div><div><span>02</span><h3>Pay your way.</h3><p>M-Pesa checkout, straight to your phone.</p><a href="/account">Your account ↗</a></div><div><span>03</span><h3>Let’s get it to you.</h3><p>Delivery quoted for your location.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer">Ask about delivery ↗</a></div></section>
</div>
</Layout>
<script>import '../scripts/collection';</script>
