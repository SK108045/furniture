---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import Icon from '../components/Icon.astro';
import {products,money} from '../data/products';
const categories=[{name:'Seating',title:'Take your seat.',image:'10.jpg',description:'Office chairs & reception seating'},{name:'Desks',title:'Room for your ideas.',image:'5.jpg',description:'Desks for home & office'},{name:'Workspace sets',title:'Bring it all together.',image:'4.jpg',description:'A coordinated place to work'}];
const workday=products.find(p=>p.id===4)!;
---
<Layout title="Shop Office Furniture — Nicoo Furniture">
<section class="collection-intro"><div><p class="eyebrow">THE NICOO COLLECTION · DONHOLM, NAIROBI</p><h1>Find your<br/><em>kind of comfort.</em></h1></div><p>For your home office. For your next big move.<br/>Furniture for the way Nairobi works.<br/><span>Karibu. Find something that feels like you.</span></p></section>
<section class="category-section page-shell" aria-label="Shop by category"><div class="mini-section-heading"><h2>Start with your space</h2><span>THREE WAYS TO MAKE IT YOURS</span></div><div class="category-grid">{categories.map(c=>{const items=products.filter(p=>p.category===c.name);return <a class="category-tile" href={`/collection?category=${encodeURIComponent(c.name)}#all-products`}><div class="category-photo"><img src={`/images/${c.image}`} alt={c.description} width="600" height="500" loading="lazy"/><span>{items.length} {items.length===1?'piece':'pieces'}</span></div><div class="category-copy"><p>{c.description}</p><h3>{c.title}</h3><div><strong>From {money(Math.min(...items.map(p=>p.price)))}</strong><Icon size={20}/></div></div></a>;})}</div></section>
<section class="catalog" id="all-products"><div class="catalog-title"><div><p class="eyebrow">GOOD FINDS. CLEAR PRICES.</p><h2>Shop the collection<span class="orange">.</span></h2></div><p>All prices in Kenyan shillings.</p></div><div class="catalog-toolbar"><div class="filters" role="group" aria-label="Filter by furniture category">{['All pieces','Seating','Desks','Workspace sets'].map((c,i)=><button data-filter={c} class:list={{selected:i===0}} aria-pressed={i===0}>{c}{i===0&&<span>{products.length}</span>}</button>)}</div><div class="catalog-selects"><label class="sort-label">Budget<select id="budget"><option value="all">Any budget</option><option value="15000">Up to KSh 15,000</option><option value="25000">Up to KSh 25,000</option><option value="35000">Up to KSh 35,000</option></select></label><label class="sort-label">Sort by<select id="sort"><option value="featured">Featured</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option></select></label></div></div><div class="catalog-count"><span id="result-count" role="status">10 pieces for your space</span><span>SELECTED IN NAIROBI</span></div><div class="product-grid" id="catalog-grid">{products.map(p=><ProductCard product={p}/>)}</div><div id="catalog-empty" class="catalog-empty" hidden><h3>No pieces in this combination—yet.</h3><p>Try a different category or a wider budget.</p><button id="reset-filters" class="button dark">See all furniture <Icon/></button></div></section>
<section class="collection-feature page-shell"><div class="collection-feature-image"><img src="/images/4.jpg" alt="White desk, drawer unit and black office chair in the Workday Set" width="1080" height="1080" loading="lazy"/></div><div class="collection-feature-copy"><p class="eyebrow">THE WORKDAY SET</p><h2>Ofisi yako.<br/><em>Your way.</em></h2><p>A desk, a chair, and space for what’s next. Give your working day a fresh start with a coordinated setup.</p><div class="feature-price"><span>The complete set</span><strong>{money(workday.price)}</strong></div><button class="button light" data-add={workday.id}>Add set to cart <Icon name="bag"/></button><button class="feature-detail" data-product={workday.id}>Take a closer look ↗</button></div></section>
<section class="shopping-help page-shell"><div><p class="eyebrow">A LITTLE HELP BEFORE YOU SHOP</p><h2>Good questions.<br/><em>Straight answers.</em></h2><p>Still deciding? Let’s talk about your space.</p><a class="text-link" href="/visit#enquiry">Ask Nicoo <Icon size={19}/></a></div><div class="shop-faq"><details open><summary>Can I see the furniture before choosing?</summary><p>Nicoo Furniture is in Donholm, Nairobi. Save your favourites and visit to check the fit and finish. The exact shop pin and opening hours will be confirmed before launch.</p></details><details><summary>How much is delivery?</summary><p>Delivery costs and availability need to be confirmed with the shop for your location. Product prices shown here exclude any delivery charge.</p></details><details><summary>Can I pay with M-Pesa?</summary><p>M-Pesa STK checkout is planned for the full store. This preview lets you try the checkout journey, but it does not request or take payment.</p></details><details><summary>What should I check before buying?</summary><p>Measure your room and doorways, then confirm the product dimensions, finish, availability and included pieces with the shop. Chairs in desk photos are not included unless the listing is a workspace set.</p></details></div></section>
</Layout>
<script>
import {products} from '../data/products';
const filters=document.querySelectorAll<HTMLButtonElement>('[data-filter]');
const grid=document.querySelector('#catalog-grid')!;
const cards=Array.from(grid.querySelectorAll<HTMLElement>('.product-card'));
const budget=document.querySelector<HTMLSelectElement>('#budget')!;
const sort=document.querySelector<HTMLSelectElement>('#sort')!;
const productFor=(card:HTMLElement)=>products.find(p=>p.id===Number(card.querySelector<HTMLElement>('[data-product]')!.dataset.product))!;
let active='All pieces';
function update(){
 let visible=0;
 cards.forEach(card=>{const show=(active==='All pieces'||card.dataset.category===active)&&(budget.value==='all'||productFor(card).price<=Number(budget.value));card.hidden=!show;if(show)visible++;});
 document.querySelector('#result-count')!.textContent=`${visible} ${visible===1?'piece':'pieces'} for your space`;
 document.querySelector<HTMLElement>('#catalog-empty')!.hidden=visible>0;
 filters.forEach(b=>{const on=b.dataset.filter===active;b.classList.toggle('selected',on);b.setAttribute('aria-pressed',String(on));});
 [...cards].sort((a,b)=>{const pa=productFor(a),pb=productFor(b);return sort.value==='low'?pa.price-pb.price:sort.value==='high'?pb.price-pa.price:pa.id-pb.id;}).forEach(card=>grid.append(card));
 const url=new URL(location.href);if(active==='All pieces')url.searchParams.delete('category');else url.searchParams.set('category',active);if(budget.value==='all')url.searchParams.delete('budget');else url.searchParams.set('budget',budget.value);history.replaceState(null,'',url);
}
const params=new URLSearchParams(location.search);
const requestedBudget=params.get('budget');if(requestedBudget&&Array.from(budget.options).some(o=>o.value===requestedBudget))budget.value=requestedBudget;
const query=params.get('category');if(query&&Array.from(filters).some(b=>b.dataset.filter===query))active=query;
filters.forEach(b=>b.addEventListener('click',()=>{active=b.dataset.filter!;update();}));
budget.addEventListener('change',update);sort.addEventListener('change',update);
document.querySelector('#reset-filters')!.addEventListener('click',()=>{active='All pieces';budget.value='all';sort.value='featured';update();filters[0].focus();});
update();
</script>
