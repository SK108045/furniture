---
import Layout from '../layouts/Layout.astro';
import AccountLoader from '../components/AccountLoader.astro';
---
<Layout title="KSh 1 payment test — Nicoo Furniture">
<section class="section payment-test-page"><p class="eyebrow">M-PESA · NO SIGN-IN NEEDED</p><h1>One bob.<br/><em>One simple test.</em></h1><p>Send a real KSh 1 M-Pesa prompt to your phone. This is a test payment only; no furniture or delivery is included.</p>
<form id="guest-test-form" class="portal-form" style="margin-top:30px"><fieldset disabled><label>M-Pesa number<input type="tel" name="phone" placeholder="0712 345 678" required maxlength="30" autocomplete="tel"/></label><label>Receipt email <small>(optional)</small><input type="email" name="email" maxlength="254" autocomplete="email" placeholder="you@example.com"/></label><label class="checkout-consent"><input type="checkbox" required/><span>I understand this sends a real KSh 1 payment request.</span></label><button type="submit" class="button dark">Send KSh 1 prompt →</button></fieldset></form>
<div id="guest-test-loading" hidden><AccountLoader compact label="Sending your KSh 1 prompt…"/></div>
<p id="guest-test-error" role="alert" style="margin-top:20px"></p>
<section id="guest-test-result" class="payment-result" hidden aria-live="polite"><p class="eyebrow">YOUR TEST PAYMENT</p><h2 data-test-title></h2><p data-test-note></p><dl><div><dt>Order reference</dt><dd data-test-reference></dd></div><div><dt>Amount</dt><dd>KSh 1</dd></div><div data-test-receipt-row hidden><dt>M-Pesa receipt</dt><dd data-test-receipt></dd></div></dl><button id="guest-test-refresh" type="button" class="button outline-button">Refresh status</button><button id="guest-test-new" type="button" class="auth-text-button" hidden>Start another test →</button></section>
<p style="margin-top:30px;font-size:13px">Only a confirmed payment is shown as paid. Keep this browser open to follow the result.</p><a class="text-link" href="/collection" style="margin-top:20px">Back to the collection ↗</a></section>
</Layout>
<script>import '../scripts/payment-test';</script>
