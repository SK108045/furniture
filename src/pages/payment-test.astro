---
import Layout from '../layouts/Layout.astro';
import AccountLoader from '../components/AccountLoader.astro';
---
<Layout title="KSh 1 payment test — Nicoo Furniture Hub">
<section class="section payment-test-page"><p class="eyebrow">M-PESA · NO SIGN-IN NEEDED</p><h1>One bob.<br/><em>One simple test.</em></h1><p>Send a real KSh 1 M-Pesa prompt to your phone. This is a test payment only; no furniture or delivery is included.</p>
<form id="guest-test-form" class="portal-form" style="margin-top:30px"><fieldset disabled><div class="field-grid"><label>First name<input name="firstName" autocomplete="given-name" required maxlength="60" placeholder="First name"/></label><label>Last name<input name="lastName" autocomplete="family-name" required maxlength="60" placeholder="Last name"/></label></div><label>M-Pesa number<input type="tel" name="phone" placeholder="0712 345 678" required maxlength="30" autocomplete="tel"/></label><label>Receipt email <small>(optional)</small><input type="email" name="email" maxlength="254" autocomplete="email" placeholder="you@example.com"/></label><label class="checkout-consent"><input type="checkbox" required/><span>I understand this sends a real KSh 1 payment request.</span></label><button type="submit" class="button dark">Send KSh 1 prompt →</button></fieldset></form>
<div id="guest-test-loading" hidden><AccountLoader compact label="Sending your KSh 1 prompt…"/></div>
<p id="guest-test-error" role="alert" style="margin-top:20px"></p>
<section id="guest-test-result" class="payment-result" hidden aria-live="polite"><p class="eyebrow">YOUR TEST PAYMENT</p><h2 data-test-title></h2><p data-test-note></p><dl><div><dt>Order reference</dt><dd data-test-reference></dd></div><div><dt>Amount</dt><dd>KSh 1</dd></div><div data-test-receipt-row hidden><dt>M-Pesa receipt</dt><dd data-test-receipt></dd></div></dl><button id="guest-test-refresh" type="button" class="button outline-button">Refresh status</button><button id="guest-test-new" type="button" class="auth-text-button" hidden>Start another test →</button></section>
<p style="margin-top:30px;font-size:13px">Only a confirmed payment is shown as paid. Keep this browser open to follow the result.</p><a class="text-link" href="/collection" style="margin-top:20px">Back to the collection ↗</a></section>
<style>
.payment-test-page{max-width:760px;margin:0 auto}
.payment-test-page>p:not(.eyebrow){max-width:620px;line-height:1.8;color:var(--muted)}
.payment-test-page h1{font-size:clamp(52px,7vw,76px);letter-spacing:-3.5px;line-height:1.02;margin:20px 0 24px}
.payment-test-page .portal-form{max-width:620px}
.payment-test-page .portal-form fieldset{width:100%}
.payment-test-page .checkout-consent{
  display:flex!important;
  flex-direction:row!important;
  align-items:flex-start!important;
  gap:11px!important;
  width:100%;
  min-width:0;
}
.payment-test-page .portal-form .checkout-consent input[type="checkbox"]{
  width:18px!important;
  min-width:18px!important;
  max-width:18px!important;
  height:18px!important;
  padding:0!important;
  margin:2px 0 0!important;
  flex:0 0 18px!important;
}
.payment-test-page .checkout-consent span{
  display:block;
  min-width:0;
  flex:1 1 auto;
  overflow-wrap:anywhere;
}
.payment-test-page .portal-form .button{margin-top:3px}
@media(max-width:600px){
  .payment-test-page{padding:38px 6% 60px}
  .payment-test-page .eyebrow{font-size:9px;letter-spacing:1.4px}
  .payment-test-page h1{font-size:clamp(44px,14vw,58px);letter-spacing:-2.7px;margin:16px 0 20px}
  .payment-test-page>p:not(.eyebrow){font-size:13px;line-height:1.75}
  .payment-test-page .portal-form{margin-top:24px!important}
  .payment-test-page .portal-form .field-grid{grid-template-columns:1fr;gap:0}
  .payment-test-page .portal-form label{font-size:11px;margin-bottom:17px}
  .payment-test-page .portal-form input{font-size:14px;padding:14px 13px}
  .payment-test-page .checkout-consent{font-size:11px!important;line-height:1.55;margin:19px 0 22px!important}
  .payment-test-page .portal-form .button{width:100%;justify-content:center;min-height:52px}
  .payment-test-page .payment-result{padding:22px 18px}
  .payment-test-page .payment-result h2{font-size:28px}
  .payment-test-page .payment-result dl>div{align-items:flex-start}
}
</style>
</Layout>
<script>import '../scripts/payment-test';</script>
