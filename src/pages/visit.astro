---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {pageCatalogue} from '../server/catalogue';
const products=await pageCatalogue(Astro.locals);
import {whatsapp,phone,phoneInternational} from '../data/contact';
---
<Layout title="Visit Us in Donholm — Nicoo Furniture Hub">
<section class="visit-hero page-shell"><div><p class="eyebrow">YOUR NEIGHBOURHOOD FURNITURE SHOP</p><h1>Karibu<br/><em>Donholm.</em></h1><p>Some things are better in person.<br/>Find your seat, picture your workspace, and let’s talk furniture.</p><a class="button dark" href="#enquiry">Let’s talk <Icon/></a></div><div class="visit-photo"><img src="/images/6.jpg" alt="Wood-look desk and office chairs from the Nicoo collection" width="1080" height="1080"/><span>NICOO FURNITURE HUB · NAIROBI, KENYA</span></div></section>
<section class="visit-strip page-shell" aria-label="Planning your visit"><div><Icon name="pin"/><div><h2>Find us in Donholm</h2><p>Nairobi, Kenya</p></div></div><div><Icon name="bag"/><div><h2>Have a piece in mind?</h2><p>Bring the product name or a screenshot.</p></div></div><div><Icon name="truck"/><div><h2>Planning delivery?</h2><p>Have your estate and location ready.</p></div></div></section>
<section class="enquiry-section page-shell" id="enquiry"><div class="enquiry-copy"><p class="eyebrow">TUPANGE YOUR SPACE</p><h2>Big plans.<br/>Small questions.<br/><em>All welcome.</em></h2><p>Choosing your first desk? Furnishing an office? Tell us what you have in mind, your budget, and where it’s going.</p><div class="location-card"><Icon name="pin" size={26}/><h3>Donholm, Nairobi</h3><p><a href={`tel:${phoneInternational}`}>{phone}</a></p><a class="text-link" href={whatsapp} target="_blank" rel="noopener noreferrer">Chat on WhatsApp ↗</a><p>Find us around Donholm, Nairobi. Call or WhatsApp for the exact shop entrance and today’s opening hours.</p><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Donholm+Nairobi+Kenya" target="_blank" rel="noopener noreferrer">View Donholm on Maps ↗</a></div></div>
<form id="enquiry-form" class="enquiry-form"><div class="enquiry-form-heading"><h2>What can we help with?</h2><span>SEND AN ENQUIRY</span></div><p class="form-demo-note">Tell us what you need and we’ll have your enquiry ready for the Nicoo team.</p><input class="enquiry-honeypot" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"/><div class="enquiry-fields"><label>Your name<input name="name" autocomplete="name" required maxlength="100" placeholder="Your full name"/></label><label>Phone number<input name="phone" type="tel" autocomplete="tel" required placeholder="0712 345 678"/></label></div><label>Email (optional)<input name="email" type="email" autocomplete="email" placeholder="you@example.com"/></label><div class="enquiry-fields"><label>I’d like help with<select name="topic"><option>Planning a visit</option><option>A product question</option><option>Delivery to my area</option><option>Furnishing an office</option></select></label><label>Interested in (optional)<select name="product"><option value="">Still exploring</option>{products.map(p=><option value={p.id}>{p.name}</option>)}</select></label></div><label>Your message<textarea name="message" rows="5" required minlength="10" maxlength="2000" placeholder="Tell us about your space, budget, or the piece you’re interested in…"></textarea></label><button class="button dark enquiry-submit" type="submit" id="enquiry-submit"><span class="enquiry-submit-label">Send enquiry</span><span class="enquiry-submit-arrow" aria-hidden="true">↗</span><span class="enquiry-loader" aria-hidden="true"><i></i><i></i><i></i></span></button><div id="enquiry-result" class="enquiry-result" role="status" tabindex="-1" hidden><strong data-result-title></strong><p data-result-copy></p></div></form></section>
<section class="donholm-map page-shell" id="map"><div class="map-heading"><div><p class="eyebrow">RIGHT HERE IN THE NEIGHBOURHOOD</p><h2>All roads lead to <em>Donholm.</em></h2><p>Come find your next favourite. The map points to Donholm, Nairobi; call us for the exact shop entrance.</p></div><a class="button dark" href="https://www.google.com/maps/dir/?api=1&destination=Donholm%2C%20Nairobi%2C%20Kenya" target="_blank" rel="noopener noreferrer">Get directions ↗</a></div><div class="map-frame"><iframe title="Map of Donholm, Nairobi, Kenya" src="https://maps.google.com/maps?q=Donholm%2C%20Nairobi%2C%20Kenya&amp;z=15&amp;output=embed" width="1200" height="450" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe><div class="map-caption"><span class="map-live-dot"></span> DONHOLM, NAIROBI <span>Good furniture. Just around the corner.</span></div></div></section>
<section class="visit-checklist page-shell"><p class="eyebrow">BEFORE YOU DROP BY</p><h2>A little planning. A better fit.</h2><div><article><span>01</span><h3>Measure your space</h3><p>Note the width, depth and any doorways your furniture will need to pass through.</p></article><article><span>02</span><h3>Save your favourites</h3><p>Add pieces to your bag, or bring screenshots so it’s easy to find what caught your eye.</p></article><article><span>03</span><h3>Think about the journey home</h3><p>Ask about collection or delivery, including the cost and timing for your location.</p></article></div></section>

<style>
.enquiry-honeypot{position:absolute!important;left:-10000px!important;width:1px!important;height:1px!important;opacity:0!important;pointer-events:none!important}
.enquiry-submit{position:relative;min-width:190px;justify-content:center;overflow:hidden}
.enquiry-submit .enquiry-loader{display:none;align-items:center;gap:5px}
.enquiry-submit .enquiry-loader i{width:6px;height:6px;border-radius:50%;background:currentColor;animation:enquiryPulse .9s infinite ease-in-out}
.enquiry-submit .enquiry-loader i:nth-child(2){animation-delay:.12s}
.enquiry-submit .enquiry-loader i:nth-child(3){animation-delay:.24s}
.enquiry-submit.is-loading .enquiry-submit-label,.enquiry-submit.is-loading .enquiry-submit-arrow{display:none}
.enquiry-submit.is-loading .enquiry-loader{display:flex}
.enquiry-submit.is-success{background:#315c3c;color:#fff}
.enquiry-result.is-success{border-color:#9fb5a3;background:#eef5ee}
.enquiry-result.is-error{border-color:#d7aaa1;background:#fff1ee}
@keyframes enquiryPulse{0%,80%,100%{transform:translateY(0);opacity:.35}40%{transform:translateY(-5px);opacity:1}}
</style>

</Layout>
<script>
const form=document.querySelector<HTMLFormElement>('#enquiry-form')!;
const phone=form.querySelector<HTMLInputElement>('[name="phone"]')!;
const message=form.querySelector<HTMLTextAreaElement>('[name="message"]')!;
const result=document.querySelector<HTMLElement>('#enquiry-result')!;
const submit=form.querySelector<HTMLButtonElement>('#enquiry-submit')!;
const title=result.querySelector<HTMLElement>('[data-result-title]')!;
const copy=result.querySelector<HTMLElement>('[data-result-copy]')!;

phone.addEventListener('input',()=>phone.setCustomValidity(''));
message.addEventListener('input',()=>message.setCustomValidity(''));
form.addEventListener('input',()=>{
  result.hidden=true;
  result.classList.remove('is-success','is-error');
  submit.classList.remove('is-success');
  submit.disabled=false;
  submit.querySelector<HTMLElement>('.enquiry-submit-label')!.textContent='Send enquiry';
});

form.addEventListener('submit',async event=>{
  event.preventDefault();

  if(!/^(?:\+?254|0)[17]\d{8}$/.test(phone.value.replace(/[\s()-]/g,''))){
    phone.setCustomValidity('Use a Kenyan mobile number, such as 0712345678 or +254712345678.');
    phone.reportValidity();
    return;
  }
  if(message.value.trim().length<10){
    message.setCustomValidity('Please add a little more detail (at least 10 characters).');
    message.reportValidity();
    return;
  }

  submit.disabled=true;
  submit.classList.add('is-loading');
  result.hidden=true;

  const values=Object.fromEntries(new FormData(form).entries());

  try{
    const response=await fetch('/api/enquiries',{
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify(values),
    });
    const data=await response.json();
    if(!response.ok)throw new Error(data.error||'Could not send your enquiry.');

    submit.classList.remove('is-loading');
    submit.classList.add('is-success');
    submit.querySelector<HTMLElement>('.enquiry-submit-label')!.textContent='Sent';
    result.classList.remove('is-error');
    result.classList.add('is-success');
    title.textContent='Enquiry sent successfully.';
    copy.textContent='Asante! The Nicoo team has received your enquiry and can follow up using the contact details you provided.';
    result.hidden=false;
    result.focus();
    form.reset();
  }catch(error){
    submit.classList.remove('is-loading','is-success');
    submit.disabled=false;
    result.classList.remove('is-success');
    result.classList.add('is-error');
    title.textContent='We couldn’t send that just yet.';
    copy.textContent=error instanceof Error?error.message:'Please try again in a moment.';
    result.hidden=false;
    result.focus();
  }
});
</script>
