---
import Layout from '../layouts/Layout.astro';
import {whatsapp} from '../data/contact';
---
<Layout title="My Account — Nicoo Furniture">
<section class="account-page" data-auth-page="account">
  <div class="account-heading"><div><p class="eyebrow">YOUR LITTLE CORNER OF NICOO</p><h1>Karibu<span data-customer-name></span><em>.</em></h1><p>Your pieces, your plans, your next chapter. All right here.</p></div><a class="button dark" href="/collection">Find your next favourite ↗</a></div>
  <div data-auth-status role="status" aria-live="polite">Opening your account…</div>
  <div data-auth-fallback hidden class="account-empty"><h2>Your space is waiting.</h2><p>We couldn’t connect to your account. Please sign in again.</p><a class="button dark" href="/sign-in">Sign in ↗</a></div>
  <div data-account-content hidden>
    <div class="account-stats"><article><span>YOUR COLLECTION, GROWING</span><strong id="account-order-count">—</strong><p>orders placed</p></article><article><span>A LITTLE CLOSER TO HOME</span><strong id="account-pending-count">—</strong><p>awaiting payment confirmation</p></article><article class="account-stat-brand"><img src="/images/mpesa.svg" alt="M-Pesa" width="133" height="38"/><h2>Familiar payments.<br/>Fresh possibilities.</h2><a href="/checkout">Back to checkout ↗</a></article></div>
    <nav class="account-tabs" aria-label="Your account sections"><a href="#orders">My orders</a><a href="#delivery-details">Delivery details</a><a href="#profile">Profile & security</a><button type="button" class="auth-signout" data-sign-out>Sign out ↗</button></nav>
    <section id="orders" class="portal-section"><div class="portal-section-heading"><div><p class="eyebrow">FROM OUR SHOP TO YOUR SPACE</p><h2>Your orders.</h2></div><button type="button" id="refresh-orders" class="auth-text-button">Refresh orders ↻</button></div><div id="account-orders" aria-live="polite">Loading your orders…</div></section>
    <section id="delivery-details" class="portal-section delivery-profile"><div><p class="eyebrow">NEXT TIME, A LITTLE QUICKER</p><h2>Where’s home?</h2><p>Save your usual delivery details. You can change them at checkout whenever you need.</p><a href="/visit" class="text-link">Picking up? Find us in Donholm ↗</a></div><form id="profile-form"><div class="field-grid"><label>First name<input name="firstName" autocomplete="given-name" required maxlength="60"/></label><label>Last name<input name="lastName" autocomplete="family-name" required maxlength="60"/></label></div><label>Phone number<input name="phone" type="tel" autocomplete="tel" required maxlength="30" placeholder="0712 345 678"/></label><label>Usual preference<select name="delivery"><option value="delivery">Nairobi delivery</option><option value="pickup">Pickup in Donholm</option></select></label><label data-profile-address>Delivery address<textarea name="address" autocomplete="street-address" rows="3" maxlength="400" required placeholder="Estate, building and nearest landmark"></textarea></label><button class="button dark" type="submit">Save my details ↗</button><p id="profile-status" role="status"></p></form></section>
    <section id="profile" class="portal-section"><div class="portal-section-heading"><div><p class="eyebrow">MAKE YOURSELF AT HOME</p><h2>Profile & security.</h2></div></div><div data-auth-widget></div></section>
  </div>
  <div class="account-notes"><article><span>01 / YOUR BAG</span><h2>Found your favourite?</h2><p>Your bag stays in this browser. Pick up where you left off.</p><button type="button" data-cart-open>Open shopping bag →</button></article><article><span>02 / DONHOLM, NAIROBI</span><h2>Come through.</h2><p>See your next piece in person and talk through the details.</p><a href="/visit">Plan your visit →</a></article><article><span>03 / WE’RE HERE TO HELP</span><h2>Let’s talk furniture.</h2><p>A question about your order? Share your Nicoo order reference with us.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer">Chat with Nicoo ↗</a></article></div>
</section>
</Layout>
