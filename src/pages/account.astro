---
import Layout from '../layouts/Layout.astro';
import AccountLoader from '../components/AccountLoader.astro';
import {products} from '../data/products';
import {whatsapp} from '../data/contact';
---
<Layout title="My Account — Nicoo Furniture">
<section class="account-page portal-v2" data-auth-page="account" aria-busy="true">
  <AccountLoader/>
  <div data-auth-status role="status" aria-live="polite"></div>
  <div data-auth-fallback hidden class="account-empty"><h2>Your space is waiting.</h2><p>We couldn’t connect to your account. Please sign in again.</p><a class="button dark" href="/sign-in">Sign in ↗</a></div>
  <div data-account-content hidden>
    <div class="portal-welcome"><div><p class="eyebrow">KARIBU NICOO HARDWARE · YOUR ACCOUNT</p><h1>Good to have you back<span data-customer-name></span><em>.</em></h1><p>Your furniture, your details, your next move.</p><span class="portal-email" data-account-email></span></div><a class="button light" href="/collection">Find your next favourite ↗</a><span class="welcome-star" aria-hidden="true">✳</span></div>
    <div class="account-stats"><article><span>YOUR ORDERS</span><strong id="account-order-count">0</strong><p>placed with Nicoo</p></article><article><span>NEEDS YOUR ATTENTION</span><strong id="account-pending-count">0</strong><p>drafts or unconfirmed payments</p></article><article><span>YOUR SPACE, UPGRADED</span><strong id="account-spend">KSh 0</strong><p>confirmed furniture payments</p></article></div>
    <div class="portal-layout">
      <aside class="portal-sidebar"><p class="eyebrow">MAKE YOURSELF AT HOME</p><nav class="account-tabs" aria-label="Your account"><a href="#orders" data-portal-tab="orders" aria-current="page"><span>01</span> My orders <b>↗</b></a><a href="#delivery-details" data-portal-tab="delivery-details"><span>02</span> Delivery details <b>↗</b></a><a href="#profile" data-portal-tab="profile"><span>03</span> Profile & security <b>↗</b></a></nav><div class="portal-help"><p>A real person.<br/>A little help.</p><a href={whatsapp} target="_blank" rel="noopener noreferrer">Talk to Nicoo ↗</a><small>Have your order reference handy.</small></div><button type="button" class="auth-signout" data-sign-out>Sign out ↗</button></aside>
      <div class="portal-main">
        <section id="orders" class="portal-section" data-portal-panel>
          <div class="portal-section-heading"><div><p class="eyebrow">ALL YOUR PIECES, IN ONE PLACE</p><h2>Your orders.</h2></div><button type="button" id="refresh-orders" class="auth-text-button">Refresh orders ↻</button></div>
          <div class="order-tools"><label><span>Find an order</span><input id="order-search" type="search" placeholder="Reference, furniture or receipt…" autocomplete="off"/></label><label><span>Show</span><select id="order-filter"><option value="all">All orders</option><option value="draft">Saved drafts</option><option value="pending">Awaiting payment</option><option value="paid">Paid</option><option value="failed">Failed payments</option><option value="cancelled">Cancelled drafts</option></select></label><label><span>Sort by</span><select id="order-sort"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="amount">Highest total</option></select></label></div>
          <p id="orders-feedback" role="status" class="portal-feedback"></p><p id="order-results-count" class="field-help"></p>
          <div id="account-orders" aria-live="polite"></div><button type="button" id="show-more-orders" class="button outline-button" hidden>Show more orders ↓</button>
        </section>
        <section id="delivery-details" class="portal-section" data-portal-panel hidden>
          <div class="portal-section-heading"><div><p class="eyebrow">SAVED TO YOUR NICOO ACCOUNT</p><h2>Your usual destination.</h2></div></div>
          <p class="portal-description">Save once, use it at your next checkout—even on another device. Changes here apply to future orders; use “Edit delivery” on an order to update that order.</p>
          <div id="saved-address" class="saved-address" hidden></div>
          <p id="profile-status" role="status" class="portal-feedback"></p>
          <button type="button" id="retry-profile" class="auth-text-button" hidden>Reload saved details ↻</button>
          <form id="profile-form" class="portal-form"><fieldset disabled><div class="field-grid"><label>First name<input name="firstName" autocomplete="given-name" required maxlength="60"/></label><label>Last name<input name="lastName" autocomplete="family-name" required maxlength="60"/></label></div><label>Contact & default M-Pesa number<input name="phone" type="tel" autocomplete="tel" required maxlength="30" placeholder="0712 345 678"/></label><label>Usual preference<select name="delivery"><option value="delivery">Nairobi delivery</option><option value="pickup">Pickup in Donholm</option></select></label><label data-profile-address>Delivery address<textarea name="address" autocomplete="street-address" rows="3" maxlength="400" required placeholder="Estate, building and nearest landmark"></textarea></label><label>Delivery instructions <small>Optional</small><textarea name="note" rows="2" maxlength="300" placeholder="Gate number, access instructions…"></textarea></label><div class="portal-form-actions"><button class="button dark" type="submit" id="save-profile">Save my details ↗</button><button type="button" id="reset-profile" class="auth-text-button">Discard changes</button></div><p id="profile-dirty" class="field-help"></p></fieldset></form>
          <div class="profile-delete-confirm" id="profile-delete-confirm" hidden><p>Remove your saved delivery details? Existing orders keep their delivery information.</p><button type="button" id="confirm-delete-profile" class="danger-button">Remove saved details</button><button type="button" id="keep-profile" class="auth-text-button">Keep them</button></div>
        </section>
        <section id="profile" class="portal-section" data-portal-panel hidden><div class="portal-section-heading"><div><p class="eyebrow">YOUR DETAILS. YOUR CONTROL.</p><h2>Profile & security.</h2></div></div><p class="portal-description">Manage your name, verified email, password and active sessions.</p><p id="profile-widget-status" role="status"></p><div data-auth-widget></div></section>
      </div>
    </div>
  </div>
  <dialog id="order-editor" class="order-editor" aria-labelledby="order-editor-title"><div class="editor-header"><div><p class="eyebrow" id="editor-reference"></p><h2 id="order-editor-title">Make it yours.</h2></div><button type="button" data-editor-close aria-label="Close order editor">×</button></div><p id="editor-explanation"></p>
    <form id="order-edit-form" class="portal-form"><fieldset><div id="editor-products-wrap"><div id="editor-products"></div><div class="editor-add"><label>Add a piece<select id="editor-add-product">{products.filter(p=>!p.quoteOnly&&!p.testOnly).map(p=><option value={p.id}>{p.name}</option>)}</select></label><button type="button" id="editor-add-button" class="button outline-button">Add +</button></div><div class="editor-total"><span>Furniture total</span><strong id="editor-total"></strong></div></div>
      <div class="field-grid"><label>First name<input name="firstName" required maxlength="60"/></label><label>Last name<input name="lastName" required maxlength="60"/></label></div><label>Delivery contact number<input name="contactPhone" type="tel" required maxlength="30"/></label><label>Delivery preference<select name="delivery"><option value="delivery">Nairobi delivery</option><option value="pickup">Pickup in Donholm</option></select></label><label data-editor-address>Delivery address<textarea name="address" rows="3" required maxlength="400"></textarea></label><label>Delivery instructions <small>Optional</small><textarea name="note" rows="2" maxlength="300"></textarea></label>
      <div id="editor-payment"><img src="/images/mpesa.svg" alt="M-Pesa" width="120" height="34"/><label>Send the M-Pesa prompt to<input type="tel" name="phone" required maxlength="30"/></label><p class="field-help">Only “Save & pay” sends a payment prompt. Delivery fees are agreed separately with the shop.</p></div>
      <div class="portal-form-actions"><button type="submit" class="button dark" id="editor-save">Save changes</button><button type="submit" class="button pay-draft" id="editor-pay" value="pay">Save & pay with M-Pesa</button></div></fieldset><p id="editor-status" role="status" class="portal-feedback"></p>
    </form><div id="editor-discard" hidden><p>You have unsaved changes. Close without saving?</p><button type="button" id="editor-discard-yes" class="danger-button">Discard & close</button><button type="button" id="editor-keep" class="auth-text-button">Keep editing</button></div>
  </dialog>
  <noscript>Enable JavaScript to sign in and manage your orders.</noscript>
</section>
</Layout>
