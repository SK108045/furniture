---
import '../styles/global.css';
import '../styles/shop-pages.css';
import '../styles/showroom.css';
import '../styles/auth.css';
import '../styles/commerce.css';
import '../styles/portal.css';
import '../styles/navbar.css';
import '../styles/catalog-update.css';
import {phone,phoneInternational,whatsapp} from '../data/contact';
import Icon from '../components/Icon.astro';
import WhatsApp from '../components/WhatsApp.astro';
import AIChatWidget from '../components/AIChatWidget.astro';
import {env} from '../server/config';
import {pageCatalogue} from '../server/catalogue';
const catalogue=await pageCatalogue(Astro.locals);
const {title='Nicoo Funiture Hub — Make room for better.'}=Astro.props;
const path=Astro.url.pathname;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="clerk-publishable-key" content={env('PUBLIC_CLERK_PUBLISHABLE_KEY')}/><meta name="description" content="Discover office chairs, desks and workspaces at Nicoo Funiture Hub, Donholm, Nairobi. Make room for a better working day."/><meta name="theme-color" content="#242924"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><title>{title}</title></head><body>
<div class="announcement"><a href={whatsapp} target="_blank" rel="noopener noreferrer">CALL / WHATSAPP {phone} · LET’S TALK FURNITURE</a><span><Icon name="pin" size={13}/> DONHOLM, NAIROBI</span></div>
<header class="header site-header" id="site-header">
  <div class="header-left">
    <a class="brand" href="/" aria-label="Nicoo Funiture Hub home">
      <span class="brand-text">Nicoo<span class="brand-dot">.</span></span>
      <span class="brand-sub">FUNITURE HUB</span>
    </a>
  </div>
  <nav class="header-center" aria-label="Main navigation">
    <div class="header-nav-links">
      <a class:list={['nav-link', { active: path === '/' }]} href="/">Home</a>
      <a class:list={['nav-link', { active: path === '/collection' }]} href="/collection">Shop furniture</a>
      <a class:list={['nav-link', { active: path === '/about' }]} href="/about">Our story</a>
      <a class:list={['nav-link', { active: path === '/visit' }]} href="/visit">Visit us <span class="nav-arrow" aria-hidden="true">↗</span></a>
    </div>
  </nav>
  <div class="header-right">
    <a class="nav-account" href="/sign-in" data-account-link aria-label="Account">
      <span data-account-label>Sign in</span>
      <Icon name="user" size={18}/>
    </a>
    <button class="nav-cart" data-cart-open aria-label="Open shopping bag">
      <Icon name="bag" size={20}/>
      <span class="cart-label">Cart</span>
      <span class="cart-count-pill" data-cart-count>0</span>
    </button>
    <button
      class="nav-menu-toggle"
      type="button"
      data-mobile-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-site-menu"
      aria-label="Open navigation menu"
    >
      <span class="hamburger-icon" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
  <nav id="mobile-site-menu" class="mobile-site-menu" aria-label="Mobile navigation" hidden>
    <div class="mobile-site-menu-inner">
      <a class:list={['mobile-menu-link', { active: path === '/' }]} href="/">Home</a>
      <a class:list={['mobile-menu-link', { active: path === '/collection' }]} href="/collection">Shop furniture</a>
      <a class:list={['mobile-menu-link', { active: path === '/about' }]} href="/about">Our story</a>
      <a class:list={['mobile-menu-link', { active: path === '/visit' }]} href="/visit">Visit us <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>
<script type="application/json" id="nicoo-catalogue" set:html={JSON.stringify(catalogue).replaceAll('<','\\u003c')}/>
<main id="main-content"><slot/></main>
<footer id="visit" class="site-footer">
  <div class="footer-hero">
    <div class="footer-hero-copy">
      <p class="footer-kicker">DONHOLM, NAIROBI · KARIBU</p>
      <h2>Make room for<br/><em>something better.</em></h2>
      <p class="footer-intro">Office chairs, desks and workspaces for the way you live and work. Visit us in Donholm or reach out when you need a hand choosing.</p>
    </div>
    <div class="footer-connect">
      <span class="footer-connect-label">CONNECT WITH NICOO</span>
      <div class="footer-socials" aria-label="Nicoo social media">
        <a class="footer-social footer-social--whatsapp" href={whatsapp} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp Nicoo">
          <WhatsApp size={21}/>
        </a>
        <span class="footer-social footer-social--inactive" title="Instagram" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
        </span>
        <span class="footer-social footer-social--inactive" title="Facebook" aria-label="Facebook">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h3V4.5c-.6-.1-1.8-.2-3.2-.2-3.2 0-5.3 1.9-5.3 5.5V13H5v4h3.5v7H13v-7h3.6l.6-4H13v-2.8C13 9 13.3 8 14 8Z"/></svg>
        </span>
        <span class="footer-social footer-social--inactive" title="YouTube" aria-label="YouTube">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 7.2a3 3 0 0 0-2.1-2.1C17 4.6 12 4.6 12 4.6s-5 0-6.9.5A3 3 0 0 0 3 7.2 31 31 0 0 0 2.5 12 31 31 0 0 0 3 16.8a3 3 0 0 0 2.1 2.1c1.9.5 6.9.5 6.9.5s5 0 6.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM10 15.3V8.7l5.7 3.3L10 15.3Z"/></svg>
        </span>
      </div>
      <div class="footer-contact-line">
        <span>WhatsApp / Call</span>
        <a href={whatsapp} target="_blank" rel="noopener noreferrer">{phone}</a>
      </div>
    </div>
  </div>

  <div class="footer-main">
    <div class="footer-brand-block">
      <a class="footer-wordmark" href="/" aria-label="Nicoo Funiture Hub home">
        <span>Nicoo<span class="brand-dot">.</span></span>
        <small>FUNITURE HUB</small>
      </a>
      <p>Good furniture. Real possibilities.<br/>Right here in Donholm.</p>
      <div class="footer-location"><Icon name="pin" size={17}/><span>Donholm, Nairobi, Kenya</span></div>
    </div>

    <nav class="footer-column" aria-label="Shop links">
      <span class="footer-column-title">EXPLORE</span>
      <a href="/collection">Shop furniture <span>↗</span></a>
      <a href="/#offers">Fresh deals <span>↗</span></a>
      <a href="/about">Our story <span>↗</span></a>
      <a href="/visit">Visit us <span>↗</span></a>
    </nav>

    <div class="footer-column">
      <span class="footer-column-title">TALK TO US</span>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp <span>↗</span></a>
      <a href={`tel:${phoneInternational}`}>Call {phone} <span>↗</span></a>
      <a href="/visit#enquiry">Ask about delivery <span>↗</span></a>
      <a href="/collection">Find your next piece <span>↗</span></a>
    </div>
  </div>

  <div class="footer-categories" aria-label="What we sell">
    <span>OFFICE CHAIRS</span>
    <span>DESKS</span>
    <span>WORKSTATIONS</span>
    <span>RECEPTION DESKS</span>
    <span>BETTER SPACES</span>
  </div>

  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Nicoo Funiture Hub</span>
    <p>Furniture prices exclude delivery. Confirm dimensions, finishes and availability with the shop.</p>
    <a href="#main-content">Back to top ↑</a>
  </div>
</footer><style is:global id="nicoo-footer-styles">
.site-footer.site-footer{background:#1d2b22!important;color:#f7f3ea!important;padding:0 5% 24px!important;overflow:hidden}
.site-footer .footer-hero{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(280px,.72fr);gap:64px;align-items:end;padding:70px 0 54px;border-bottom:1px solid rgba(255,255,255,.14)}
.site-footer .footer-kicker{margin:0;font-size:10px;font-weight:700;letter-spacing:2.2px;color:#bdc9bb}
.site-footer .footer-hero h2{margin:16px 0 22px;font-size:clamp(48px,5.2vw,78px);line-height:.98;letter-spacing:-3.5px;font-weight:400;color:#fff}
.site-footer .footer-hero h2 em{color:#efb289}
.site-footer .footer-intro{max-width:560px;margin:0;font-size:15px;line-height:1.8;color:#c8d1c5}
.site-footer .footer-connect{justify-self:end;width:min(100%,360px);padding:4px 0 2px}
.site-footer .footer-connect-label{display:block;margin-bottom:15px;font-size:9px;font-weight:700;letter-spacing:2px;color:#8fa08e}
.site-footer .footer-socials{display:flex;align-items:center;gap:10px}
.site-footer .footer-social{width:42px;height:42px;border:1px solid rgba(255,255,255,.18);border-radius:50%;display:grid;place-items:center;color:#f7f3ea;background:rgba(255,255,255,.03);transition:background .2s,border-color .2s,transform .2s}
.site-footer .footer-social:hover{transform:translateY(-2px);background:rgba(255,255,255,.09);border-color:rgba(255,255,255,.35)}
.site-footer .footer-social--whatsapp{background:#178844;border-color:#178844;color:#fff}
.site-footer .footer-social--whatsapp:hover{background:#1b9b50;border-color:#1b9b50}
.site-footer .footer-social--inactive{opacity:.78;cursor:default}
.site-footer .footer-social svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.8}
.site-footer .footer-social--inactive:nth-child(3) svg,.site-footer .footer-social--inactive:nth-child(4) svg{fill:currentColor;stroke:none}
.site-footer .footer-contact-line{display:flex;justify-content:space-between;gap:18px;margin-top:18px;padding-top:16px;border-top:1px solid rgba(255,255,255,.11);font-size:12px;color:#aeb9ad}
.site-footer .footer-contact-line a{color:#f2f5ef;font-weight:600}
.site-footer .footer-main{display:grid;grid-template-columns:minmax(300px,1.5fr) minmax(150px,.7fr) minmax(190px,.8fr);gap:64px;padding:52px 0 48px}
.site-footer .footer-brand-block{min-width:0}
.site-footer .footer-wordmark{display:inline-flex;flex-direction:column;width:max-content;color:#fff}
.site-footer .footer-wordmark>span{font-size:64px;font-weight:800;letter-spacing:-4px;line-height:.84}
.site-footer .footer-wordmark small{font-size:10px;font-weight:700;letter-spacing:3px;margin:11px 0 0 3px;color:#b9c4b7}
.site-footer .footer-brand-block>p{margin:27px 0 18px;font-size:14px;line-height:1.75;color:#bcc7b9}
.site-footer .footer-location{display:flex;align-items:center;gap:9px;font-size:12px;color:#edf0e9}
.site-footer .footer-location svg{color:#efb289}
.site-footer .footer-column{display:flex;flex-direction:column;align-items:flex-start;gap:11px}
.site-footer .footer-column-title{font-size:9px;font-weight:700;letter-spacing:2px;color:#899a89;margin-bottom:9px}
.site-footer .footer-column a{display:flex;align-items:center;justify-content:space-between;gap:18px;width:100%;padding:7px 0;border-bottom:1px solid rgba(255,255,255,.06);font-size:14px;color:#edf0e9}
.site-footer .footer-column a span{color:#d98258}
.site-footer .footer-column a:hover{color:#efb289;border-color:rgba(255,255,255,.18)}
.site-footer .footer-categories{border-top:1px solid rgba(255,255,255,.14);border-bottom:1px solid rgba(255,255,255,.14);display:grid;grid-template-columns:repeat(5,1fr);align-items:center}
.site-footer .footer-categories span{position:relative;padding:19px 16px;text-align:center;font-size:10px;font-weight:700;letter-spacing:1.7px;color:#c5cec2}
.site-footer .footer-categories span+span{border-left:1px solid rgba(255,255,255,.12)}
.site-footer .footer-bottom{display:grid!important;grid-template-columns:auto 1fr auto!important;align-items:center!important;gap:28px!important;padding:22px 0 0!important;margin:0!important}
.site-footer .footer-bottom span,.site-footer .footer-bottom p,.site-footer .footer-bottom a{margin:0;font-size:10px;line-height:1.6;color:#8fa08e}
.site-footer .footer-bottom p{text-align:center}
.site-footer .footer-bottom a{color:#eef1eb;border-bottom:1px solid #667567;padding-bottom:3px}
@media(max-width:900px){
 .site-footer .footer-hero{grid-template-columns:1fr;gap:34px}
 .site-footer .footer-connect{justify-self:start;max-width:360px}
 .site-footer .footer-main{grid-template-columns:1fr 1fr;gap:40px}
 .site-footer .footer-brand-block{grid-column:1/-1}
 .site-footer .footer-categories{grid-template-columns:repeat(2,1fr)}
 .site-footer .footer-categories span+span{border-left:0}
 .site-footer .footer-categories span:nth-child(even){border-left:1px solid rgba(255,255,255,.12)}
 .site-footer .footer-categories span{border-bottom:1px solid rgba(255,255,255,.08)}
 .site-footer .footer-categories span:last-child{grid-column:1/-1;border-bottom:0}
}
@media(max-width:760px){
 .site-footer.site-footer{padding-left:6%!important;padding-right:6%!important}
 .site-footer .footer-hero{padding:48px 0 40px}
 .site-footer .footer-hero h2{font-size:48px;letter-spacing:-2.5px}
 .site-footer .footer-intro{font-size:13px}
 .site-footer .footer-main{grid-template-columns:1fr 1fr;gap:36px 24px;padding:40px 0}
 .site-footer .footer-wordmark>span{font-size:52px}
 .site-footer .footer-column a{font-size:13px}
 .site-footer .footer-bottom{grid-template-columns:1fr auto!important;gap:12px 20px!important}
 .site-footer .footer-bottom p{grid-column:1/-1;grid-row:2;text-align:left}
}
@media(max-width:440px){
 .site-footer .footer-main{grid-template-columns:1fr}
 .site-footer .footer-brand-block{grid-column:auto}
 .site-footer .footer-hero h2{font-size:42px}
 .site-footer .footer-wordmark>span{font-size:48px}
 .site-footer .footer-social{width:40px;height:40px}
 .site-footer .footer-categories{grid-template-columns:1fr}
 .site-footer .footer-categories span:nth-child(even){border-left:0}
 .site-footer .footer-categories span+span{border-top:1px solid rgba(255,255,255,.08)}
}
</style>
<dialog id="cart-dialog" class="cart-dialog" aria-labelledby="cart-title"><div class="drawer-top"><h2 id="cart-title">Your bag <span data-cart-count>0</span></h2><button class="icon-button" data-close="cart-dialog" aria-label="Close shopping bag"><Icon name="close"/></button></div><div id="cart-items"></div><div id="cart-summary"></div></dialog>
<dialog id="product-dialog" class="product-dialog" aria-labelledby="product-title"><button class="icon-button modal-close" data-close="product-dialog" aria-label="Close product details"><Icon name="close"/></button><div id="product-details"></div></dialog>
<AIChatWidget />
<div id="toast" role="status" aria-live="polite"></div>
<script>
  import '../scripts/store';
  import '../scripts/auth';

  const menuToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const mobileMenu = document.querySelector<HTMLElement>('#mobile-site-menu');

  const setMobileMenu = (open: boolean) => {
    if (!menuToggle || !mobileMenu) return;
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
    mobileMenu.hidden = !open;
    document.documentElement.classList.toggle('mobile-menu-open', open);
  };

  menuToggle?.addEventListener('click', () => {
    setMobileMenu(menuToggle.getAttribute('aria-expanded') !== 'true');
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMobileMenu(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setMobileMenu(false);
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 760) setMobileMenu(false);
  });
</script>
</body></html>
