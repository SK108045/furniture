# Browser-visible Clerk key; rebuild after changing this value.
PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server-only credentials.
CLERK_SECRET_KEY=
SWIFTA_API_KEY=
# Must match the address used in the browser, including scheme and port.
APP_ORIGIN=http://localhost:4321
# Supabase project URL and server secret (or SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Register /api/swifta/callback?token=THIS_VALUE as the callback URL.
SWIFTA_CALLBACK_TOKEN=
# For signed events, copy the secret configured in Swifta (not the API key).
SWIFTA_WEBHOOK_SECRET=
SWIFTA_WEBHOOK_SIGNATURE_HEADER=X-Swifta-Signature
# Google AI Studio Gemini API Key
GEMINI_API_KEY=
# Paid-order receipts. Clerk continues to send authentication emails.
RESEND_API_KEY=
RECEIPT_FROM=
# Set this in Vercel project settings too so Vercel authenticates its cron request.
CRON_SECRET=
